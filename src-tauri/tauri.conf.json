{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Battery Log",
  "identifier": "com.batteries.log",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Battery Log",
        "width": 1100,
        "height": 800,
        "minWidth": 480,
        "minHeight": 480,
        "theme": "Dark",
        "backgroundColor": "#12141a",
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
